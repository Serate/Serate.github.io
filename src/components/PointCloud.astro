---
/**
 * Hero 视觉：点云扫描。
 *
 * 用斐波那契球面撒点模拟一个被采集的三维场景，外加一条自上而下移动的
 * 扫描光带 —— 借喻 LiDAR / 3DGS 的采集过程。纯 Canvas 2D，无第三方依赖。
 *
 * 无障碍：aria-hidden，不承载信息；prefers-reduced-motion 下只绘制一帧静态画面。
 */
---

<div class="hero__visual">
  <canvas class="hero__canvas" data-point-cloud aria-hidden="true"></canvas>
  <span class="hero__corner hero__corner--tl"></span>
  <span class="hero__corner hero__corner--tr"></span>
  <span class="hero__corner hero__corner--bl"></span>
  <span class="hero__corner hero__corner--br"></span>
  <span class="hero__visual-label">point cloud · scan sweep</span>
</div>

<script>
  const canvas = document.querySelector<HTMLCanvasElement>('[data-point-cloud]');

  if (canvas) {
    const ctx = canvas.getContext('2d');

    if (ctx) {
      const POINT_COUNT = 2200;
      const GOLDEN = Math.PI * (3 - Math.sqrt(5));
      const BUCKETS = 7;
      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      // 斐波那契球面：分布均匀，不会像随机采样那样在两极聚集
      const points = Array.from({ length: POINT_COUNT }, (_, i) => {
        const y = 1 - (i / (POINT_COUNT - 1)) * 2;
        const r = Math.sqrt(Math.max(0, 1 - y * y));
        const theta = GOLDEN * i;
        const jitter = 0.075;
        return {
          x: Math.cos(theta) * r + (Math.random() - 0.5) * jitter,
          y: y + (Math.random() - 0.5) * jitter,
          z: Math.sin(theta) * r + (Math.random() - 0.5) * jitter,
          size: Math.random(),
        };
      });

      let width = 0;
      let height = 0;
      let dpr = 1;

      const resize = () => {
        const rect = canvas.getBoundingClientRect();
        if (!rect.width || !rect.height) return;
        dpr = Math.min(window.devicePixelRatio || 1, 2);
        width = rect.width;
        height = rect.height;
        canvas.width = Math.max(1, Math.round(width * dpr));
        canvas.height = Math.max(1, Math.round(height * dpr));
        ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      };

      // 读取当前主题的强调色，主题切换时重新取色
      const hexToRgb = (hex: string): [number, number, number] => {
        const clean = hex.replace('#', '').trim();
        const full =
          clean.length === 3
            ? clean
                .split('')
                .map((c) => c + c)
                .join('')
            : clean;
        const n = parseInt(full, 16);
        if (Number.isNaN(n)) return [92, 200, 255];
        return [(n >> 16) & 255, (n >> 8) & 255, n & 255];
      };

      let accent: [number, number, number] = [92, 200, 255];
      let fills: string[] = [];

      const readAccent = () => {
        const raw = getComputedStyle(document.documentElement).getPropertyValue('--accent').trim();
        accent = hexToRgb(raw);
        fills = Array.from({ length: BUCKETS }, (_, i) => {
          const t = (i + 1) / BUCKETS;
          return `rgba(${accent[0]}, ${accent[1]}, ${accent[2]}, ${(0.08 + t * 0.78).toFixed(3)})`;
        });
      };

      readAccent();

      // 主题切换后重新取色
      const themeObserver = new MutationObserver(() => readAccent());
      themeObserver.observe(document.documentElement, {
        attributes: true,
        attributeFilter: ['data-theme'],
      });

      let mouseX = 0;
      let mouseY = 0;
      let targetX = 0;
      let targetY = 0;

      const onPointerMove = (e: PointerEvent) => {
        const rect = canvas.getBoundingClientRect();
        targetX = ((e.clientX - rect.left) / rect.width - 0.5) * 0.55;
        targetY = ((e.clientY - rect.top) / rect.height - 0.5) * 0.35;
      };
      const onPointerLeave = () => {
        targetX = 0;
        targetY = 0;
      };

      canvas.addEventListener('pointermove', onPointerMove);
      canvas.addEventListener('pointerleave', onPointerLeave);

      const draw = (time: number) => {
        if (!width || !height) return;
        ctx.clearRect(0, 0, width, height);

        mouseX += (targetX - mouseX) * 0.05;
        mouseY += (targetY - mouseY) * 0.05;

        const yaw = time * 0.00016 + mouseX;
        const pitch = -0.3 + mouseY;
        const scan = ((time * 0.00019) % 1) * 2.2 - 1.1;

        const cosY = Math.cos(yaw);
        const sinY = Math.sin(yaw);
        const cosP = Math.cos(pitch);
        const sinP = Math.sin(pitch);

        const cx = width / 2;
        const cy = height / 2;
        const scale = Math.min(width, height) * 0.26;

        const buckets: number[][] = Array.from({ length: BUCKETS }, () => []);

        for (const p of points) {
          const x1 = p.x * cosY - p.z * sinY;
          const z1 = p.x * sinY + p.z * cosY;
          const y2 = p.y * cosP - z1 * sinP;
          const z2 = p.y * sinP + z1 * cosP;

          const persp = 3.2 / (3.2 + z2);
          const sx = cx + x1 * scale * persp;
          const sy = cy - y2 * scale * persp;

          if (sx < -10 || sx > width + 10 || sy < -10 || sy > height + 10) continue;

          // 扫描光带：离光带越近的点越亮越大
          const lit = Math.max(0, 1 - Math.abs(y2 - scan) / 0.4);
          const depth = Math.min(1, Math.max(0, (z2 + 1.2) / 2.4));

          const level = Math.min(
            BUCKETS - 1,
            Math.floor((0.12 + depth * 0.42 + lit * 0.46) * BUCKETS),
          );
          const size = (0.55 + p.size * 0.85 + lit * 1.15) * persp;

          buckets[level].push(sx, sy, size);
        }

        for (let i = 0; i < BUCKETS; i++) {
          const items = buckets[i];
          if (!items.length) continue;
          ctx.fillStyle = fills[i];
          for (let j = 0; j < items.length; j += 3) {
            const s = items[j + 2];
            ctx.fillRect(items[j] - s / 2, items[j + 1] - s / 2, s, s);
          }
        }
      };

      let frame = 0;
      let running = true;

      const loop = (time: number) => {
        if (!running) return;
        draw(time);
        frame = requestAnimationFrame(loop);
      };

      const start = () => {
        if (reduceMotion) {
          draw(2400);
          return;
        }
        running = true;
        frame = requestAnimationFrame(loop);
      };

      const stop = () => {
        running = false;
        cancelAnimationFrame(frame);
      };

      resize();
      start();

      const ro = new ResizeObserver(() => {
        resize();
        if (reduceMotion) draw(2400);
      });
      ro.observe(canvas);

      // 滚出视口时停掉动画，避免无谓的 CPU 占用
      const io = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (reduceMotion) continue;
            if (entry.isIntersecting) start();
            else stop();
          }
        },
        { threshold: 0 },
      );
      io.observe(canvas);
    }
  }
</script>
