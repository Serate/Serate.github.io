---
import Icon from './Icon.astro';
import ThemeToggle from './ThemeToggle.astro';
import { NAV, SITE } from '../data/site';

const pathname = Astro.url.pathname;

const isActive = (href: string) => {
  if (href === '/') return pathname === '/';
  if (href.includes('#')) return false;
  return pathname.startsWith(href.replace(/\/$/, ''));
};
---

<header class="header">
  <div class="container header__inner">
    <a class="brand" href="/" aria-label={`${SITE.name} 的主页`}>
      <span class="brand__mark" aria-hidden="true">~/</span>
      <span>serate</span>
      <span class="brand__sub" aria-hidden="true">空间智能 · 3D 渲染</span>
    </a>

    <nav class="nav" id="site-nav" aria-label="主导航">
      {
        NAV.map((item) => (
          <a class="nav__link" href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>
            {item.label}
          </a>
        ))
      }
    </nav>

    <div class="header__actions">
      <ThemeToggle />
      <a
        class="icon-btn"
        href={SITE.github}
        target="_blank"
        rel="noopener noreferrer"
        aria-label="在 GitHub 上查看 @Serate"
      >
        <Icon name="github" />
      </a>
      <button
        class="icon-btn nav-toggle"
        type="button"
        aria-expanded="false"
        aria-controls="site-nav"
        aria-label="打开导航菜单"
      >
        <Icon name="menu" />
      </button>
    </div>
  </div>
</header>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('.nav-toggle');
  const nav = document.querySelector<HTMLElement>('#site-nav');

  const setOpen = (open: boolean) => {
    nav?.classList.toggle('is-open', open);
    toggle?.setAttribute('aria-expanded', String(open));
    toggle?.setAttribute('aria-label', open ? '关闭导航菜单' : '打开导航菜单');
  };

  toggle?.addEventListener('click', () => {
    setOpen(!nav?.classList.contains('is-open'));
  });

  nav?.addEventListener('click', (e) => {
    if ((e.target as HTMLElement).closest('a')) setOpen(false);
  });

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') setOpen(false);
  });

  // 视口变宽后重置移动端菜单状态，避免残留展开态
  const mq = window.matchMedia('(min-width: 769px)');
  mq.addEventListener('change', (e) => {
    if (e.matches) setOpen(false);
  });
</script>
