---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import { SITE } from '../data/site';
---

<BaseLayout title="页面不存在" description="你访问的页面不存在。">
  <div class="container">
    <div class="article" style="padding-block: var(--sp-9);">
      <p class="eyebrow">
        <span class="eyebrow__index">404</span>
        <span>找不到页面</span>
      </p>
      <h1 class="page-head__title">这个地址下什么都没有</h1>
      <p class="page-head__desc">
        链接可能过期了，或者你手滑打了个错字。回首页看看，或者去博客翻翻。
      </p>
      <div class="contact__actions">
        <a class="btn btn--primary" href="/">
          回到首页
          <Icon name="arrowRight" />
        </a>
        <a class="btn" href="/blog/">
          <Icon name="rss" />
          去博客
        </a>
        <a class="btn" href={SITE.github} target="_blank" rel="noopener noreferrer">
          <Icon name="github" />
          GitHub
        </a>
      </div>
    </div>
  </div>
</BaseLayout>
